<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Target Windows for the full shell extension (WinForms + COM). -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mdz.WinPrev</AssemblyName>
    <RootNamespace>MDZip.WinPrev</RootNamespace>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Windows Forms + COM hosting: only when targeting net8.0-windows -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting Condition="'$(OS)' == 'Windows_NT'">true</EnableComHosting>
  </PropertyGroup>

  <!-- Exclude Windows-only files from the net8.0 build -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="ComInterop\ComInterfaces.cs" />
    <Compile Remove="MdzPreviewHandler.cs" />
    <Compile Remove="PreviewPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="mdzip-core" Version="1.3.3" />
    <PackageReference Include="Markdig" Version="0.40.0" />
  </ItemGroup>

</Project>
